# Copy this file to ".env" (same folder as server.js) to change a setting.
# Every line is optional. The app runs fine with no .env at all.

# Port the server listens on (default 3000)
PORT=3000

# Access codes for staff accounts (citizens need no code).
# These are the defaults used when nothing is set here.
ADMIN_CODE=ADMIN2026
MANAGER_CODE=PARK2026
RESPONDER_CODE=BPSO2026

# Map tiles. Leave MAP_API_KEY empty to use the free OpenStreetMap/CARTO map.
# MAP_PROVIDER is "maptiler" or "mapbox"; MAP_STYLE is optional.
MAP_API_KEY=
MAP_PROVIDER=maptiler
MAP_STYLE=
